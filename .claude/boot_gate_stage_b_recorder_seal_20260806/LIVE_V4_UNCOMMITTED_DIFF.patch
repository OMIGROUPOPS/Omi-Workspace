+def _ws_source_epoch(message):
+    """Extract a source timestamp without pretending receive-time is source."""
+    candidates = []
+    if isinstance(message, dict):
+        candidates.append(message)
+        if isinstance(message.get("msg"), dict):
+            candidates.append(message["msg"])
+    for row in candidates:
+        for field_name in ("ts", "timestamp", "created_time", "created_at"):
+            value = row.get(field_name)
+            if value in (None, ""):
+                continue
+            try:
+                if isinstance(value, str) and not value.replace(
+                        ".", "", 1).isdigit():
+                    return datetime.fromisoformat(
+                        value.replace("Z", "+00:00")).timestamp()
+                epoch = float(value)
+                if epoch > 10_000_000_000:
+                    epoch /= 1000.0
+                return epoch
+            except (TypeError, ValueError):
+                continue
+    return None
+
+
+def _ws_frame_meta(raw, message, received_ts=None):
+    received_ts = float(received_ts or time.time())
+    raw_bytes = raw if isinstance(raw, bytes) else str(raw).encode("utf-8")
+    source_ts = _ws_source_epoch(message)
+    return {
+        "received_ts": received_ts,
+        "source_ts": source_ts,
+        "staleness_ms": (
+            round(max(0.0, received_ts - source_ts) * 1000.0, 3)
+            if source_ts is not None else None
+        ),
+        "raw_sha256": hashlib.sha256(raw_bytes).hexdigest(),
+    }
+

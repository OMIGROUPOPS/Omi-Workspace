# Credentials
.env
*.pem
kalshi.pem

# Logs
/tmp/*.log
/tmp/*.csv
*.log

# Python
__pycache__/
*.pyc
.venv/

# State files
*_live_trades.json
*_live_trades.json.bak*

# Local read-only SQLite replay snapshots and their ephemeral sidecars
/.claude/window1_live_v4_replay/vps_inputs_*/db/tennis*.db
/.claude/window1_live_v4_replay/vps_inputs_*/db/tennis*.db-wal
/.claude/window1_live_v4_replay/vps_inputs_*/db/tennis*.db-shm
/.claude/window1_live_v4_replay/**/_input_index/
/.claude/window1_live_v4_replay/**/_engine_logs/
/.claude/window1_live_v4_replay/**/_state/

# Generated bid-renewal streams and lazy stage data stay local.
/window1-watch/data/**/renewals*
/window1-watch/data/**/*.accountability.json*
/window1-watch/data/**/*.stages/

# Oversized derived JSON stays local; exact lossless .json.gz is versioned.
/window1-watch/data/KXATPCHALLENGERMATCH-26JUL12HERALM.grade.json
/window1-watch/data/KXATPCHALLENGERMATCH-26JUL12HERALM.pressure.json
/window1-watch/data/KXWTACHALLENGERMATCH-26JUL13AVDFEI.grade.json

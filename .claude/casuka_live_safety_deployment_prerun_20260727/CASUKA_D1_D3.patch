+        return {
+            "position_qty": held,
+            "authoritative_resting_sell_qty": resting,
+            "cycle_resting_sell_floor": cycle_floor,
+            "effective_resting_sell_qty": effective_resting,
+            "available_sell_qty": max(0.0, held - effective_resting),

+            "resting_sell_qty":
+                snap["authoritative_resting_sell_qty"],
+            "cycle_resting_sell_floor":
+                snap["cycle_resting_sell_floor"],
+            "order_id": oid, "source": "post_intent_authoritative_reread"},
+            ticker=ticker)
+        return oid

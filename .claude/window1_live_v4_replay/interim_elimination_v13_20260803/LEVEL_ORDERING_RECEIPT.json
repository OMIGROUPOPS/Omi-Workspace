  "levels": [
    {
      "order": 1,
      "level": "SOURCE",
      "reads": [
        "lawful contemporaneous positive-size non-crossed BBO",
        "top-five ask chain/depth"
      ],
      "unresolved": "NO LOWER LEVEL CONSULTED"
    },
    {
      "order": 2,
      "level": "MACRO_INTERIM_PATH",
      "reads": [
        "ask peak",
        "peak-to-current drawdown",
        "ask net/dip",
